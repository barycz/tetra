#!/usr/bin/env python3
"""Writes a made-up picture for the background tests: a PNG with a diagonal
gradient between two colours and a light disc ("sun"), so fill, fit and
center are easy to tell apart in screenshots.

Usage: make-test-picture FILE WIDTH HEIGHT FROM_HEX TO_HEX
"""
import struct
import sys
import zlib


def chunk(kind, data):
    body = kind + data
    return struct.pack(">I", len(data)) + body + struct.pack(">I", zlib.crc32(body) & 0xFFFFFFFF)


def parse(hex_colour):
    h = hex_colour.lstrip("#")
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))


def main():
    if len(sys.argv) != 6:
        sys.exit(__doc__)
    path, width, height = sys.argv[1], int(sys.argv[2]), int(sys.argv[3])
    a, b = parse(sys.argv[4]), parse(sys.argv[5])
    cx, cy, r = width * 0.68, height * 0.32, min(width, height) * 0.12
    rows = []
    for y in range(height):
        row = bytearray([0])  # filter: none
        for x in range(width):
            t = (x / max(1, width - 1) + y / max(1, height - 1)) / 2
            pixel = [round(a[i] + (b[i] - a[i]) * t) for i in range(3)]
            if (x - cx) ** 2 + (y - cy) ** 2 <= r * r:
                pixel = [round(c + (255 - c) * 0.7) for c in pixel]
            row += bytes(pixel)
        rows.append(bytes(row))
    data = zlib.compress(b"".join(rows), 6)
    png = b"\x89PNG\r\n\x1a\n"
    png += chunk(b"IHDR", struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0))
    png += chunk(b"IDAT", data)
    png += chunk(b"IEND", b"")
    with open(path, "wb") as f:
        f.write(png)


if __name__ == "__main__":
    main()
